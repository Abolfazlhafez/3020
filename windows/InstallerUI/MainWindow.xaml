<Window x:Class="FoxyVPN.InstallerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxyVPN Installer"
        Width="760" Height="900" MinWidth="680" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="White"
        Loaded="Window_Loaded">
  <Window.Resources>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#55FFFFFF" Offset="0"/>
      <GradientStop Color="#22EAF5FF" Offset="0.48"/>
      <GradientStop Color="#448BAFD9" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#22FFFFFF"/>
      <Setter Property="BorderBrush" Value="#66FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <!-- Atmospheric landscape made from layered gradients; the translucent glass above keeps it visible. -->
    <Grid>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF8CB9E8" Offset="0"/>
          <GradientStop Color="#FFB7CBEA" Offset="0.30"/>
          <GradientStop Color="#FF526F9A" Offset="0.63"/>
          <GradientStop Color="#FF142C4A" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-90,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#FFFFE6C2" Offset="0"/>
            <GradientStop Color="#66FFE7C9" Offset="0.32"/>
            <GradientStop Color="#00FFE7C9" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Path Data="M 0,460 C 100,400 145,445 245,375 C 335,310 390,390 470,330 C 570,255 625,340 760,265 L 760,900 L 0,900 Z"
            Fill="#55799CC7" Stretch="Fill" Opacity="0.9"/>
      <Path Data="M 0,535 C 100,460 185,515 290,435 C 380,370 450,465 545,405 C 635,350 690,405 760,365 L 760,900 L 0,900 Z"
            Fill="#77415D82" Stretch="Fill"/>
      <Path Data="M 0,620 C 135,575 210,610 315,570 C 440,520 530,610 630,560 C 690,535 720,555 760,530 L 760,900 L 0,900 Z"
            Fill="#AA203E5A" Stretch="Fill"/>
      <Rectangle VerticalAlignment="Bottom" Height="210" Fill="#552E6B8B"/>
      <Rectangle VerticalAlignment="Bottom" Height="165">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6647A0C5" Offset="0"/>
            <GradientStop Color="#CC193A5C" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Canvas IsHitTestVisible="False" Opacity="0.28">
        <Rectangle Canvas.Left="45" Canvas.Top="570" Width="42" Height="112" Fill="#FF102B45"/>
        <Rectangle Canvas.Left="95" Canvas.Top="545" Width="26" Height="140" Fill="#FF102B45"/>
        <Rectangle Canvas.Left="135" Canvas.Top="585" Width="55" Height="100" Fill="#FF102B45"/>
        <Rectangle Canvas.Left="600" Canvas.Top="565" Width="38" Height="120" Fill="#FF102B45"/>
        <Rectangle Canvas.Left="650" Canvas.Top="530" Width="28" Height="155" Fill="#FF102B45"/>
        <Rectangle Canvas.Left="695" Canvas.Top="580" Width="44" Height="105" Fill="#FF102B45"/>
        <Line X1="650" Y1="520" X2="650" Y2="350" Stroke="#FFF1D6B8" StrokeThickness="2"/>
        <Line X1="650" Y1="350" X2="637" Y2="390" Stroke="#FFF1D6B8" StrokeThickness="2"/>
        <Line X1="650" Y1="350" X2="663" Y2="390" Stroke="#FFF1D6B8" StrokeThickness="2"/>
      </Canvas>
    </Grid>

    <Border Margin="26" CornerRadius="38" Background="{StaticResource GlassFill}"
            BorderBrush="#BFFFFFFF" BorderThickness="1.4">
      <Border.Effect>
        <DropShadowEffect Color="#AA081B35" BlurRadius="36" ShadowDepth="8" Opacity="0.42"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="64"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="76"/>
        </Grid.RowDefinitions>
        <Grid Margin="26,12,26,0">
          <Button x:Name="CloseButton" Content="×" Width="38" Height="38" HorizontalAlignment="Right"
                  Style="{StaticResource GlassButton}" Padding="0" Click="CloseButton_Click"/>
          <TextBlock Text="FOXYVPN  ·  SETUP" VerticalAlignment="Center" FontSize="11"
                     FontWeight="Bold" CharacterSpacing="180" Foreground="#DFFFFFFF"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="38,14,38,20" HorizontalAlignment="Stretch">
            <Border Width="112" Height="112" CornerRadius="30" BorderBrush="#99FFFFFF" BorderThickness="1"
                    Background="#44FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24">
              <Grid>
                <Ellipse Width="76" Height="76" Fill="#22FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Data="M 20,68 L 43,27 Q 48,18 53,27 L 77,68 Q 81,76 70,76 L 27,76 Q 16,76 20,68 Z"
                      Fill="#FF48B8FF" Stretch="Uniform" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Data="M 45,69 L 63,36 Q 68,26 74,36 L 91,67 Q 95,75 85,75 L 51,75 Q 41,75 45,69 Z"
                      Fill="#995D7CFF" Stretch="Uniform" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
              </Grid>
            </Border>
            <TextBlock Text="FoxyVPN" FontSize="39" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" Text="A safer internet, beautifully simple." FontSize="16"
                       Foreground="#E8FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,5"/>
            <TextBlock Text="WINDOWS  ·  VERSION 2.6.0" FontSize="10" FontWeight="SemiBold"
                       Foreground="#CFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <Border CornerRadius="28" Background="#35FFFFFF" BorderBrush="#77FFFFFF"
                    BorderThickness="1" Padding="24">
              <StackPanel>
                <TextBlock x:Name="StatusTitle" Text="Ready to install" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDescription" Text="FoxyVPN will be installed securely on this PC."
                           FontSize="13" Foreground="#E6FFFFFF" TextWrapping="Wrap" Margin="0,8,0,20"/>
                <Grid Height="7" Margin="0,0,0,20">
                  <Border CornerRadius="4" Background="#55FFFFFF"/>
                  <Border x:Name="ProgressTrack" CornerRadius="4" HorizontalAlignment="Left" Width="0"
                          Background="#FF57C7FF"/>
                  <Border x:Name="IndeterminateTrack" CornerRadius="4" Background="#FF57C7FF"
                          Width="110" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Border.RenderTransform>
                      <TranslateTransform x:Name="ProgressTranslate"/>
                    </Border.RenderTransform>
                  </Border>
                </Grid>
                <StackPanel x:Name="Checklist" Margin="0,0,0,2">
                  <Grid Margin="0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepOneIcon" Text="○" FontSize="18" Foreground="#EFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StepOneText" Text="Preparing installation" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepTwoIcon" Text="○" FontSize="18" Foreground="#EFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StepTwoText" Text="Installing FoxyVPN components" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepThreeIcon" Text="○" FontSize="18" Foreground="#EFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StepThreeText" Text="Finishing setup" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="A clear view. A safer connection." FontSize="12" Foreground="#DFFFFFFF"
                       HorizontalAlignment="Center" Margin="0,22,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="38,0,38,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="InstallButton" Grid.Column="0" Content="Install FoxyVPN" Style="{StaticResource GlassButton}"
                  Background="#55FFFFFF" Click="InstallButton_Click"/>
          <Button x:Name="ExitButton" Grid.Column="2" Content="Close" Style="{StaticResource GlassButton}"
                  Click="CloseButton_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>