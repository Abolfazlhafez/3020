<Window x:Class="FoxyVPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxyVPN" Height="820" Width="1320" MinHeight="660" MinWidth="980"
        Background="{DynamicResource WindowBackgroundBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Sidebar: flush with the window, no divider line. -->
        <DockPanel Grid.Column="0" LastChildFill="True" Margin="16,26,12,20">
            <StackPanel DockPanel.Dock="Top" Margin="6,0,0,28" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="6" Effect="{StaticResource SoftCardShadow}">
                    <Image Source="Assets/foxy_app_icon.png" Stretch="Uniform" />
                </Border>
                <TextBlock Text="FoxyVPN" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Version 2.6.0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,12,0,0" />
            <StackPanel>
                <Button x:Name="HomeNav" Content="⌂   Overview" Click="HomeNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" Background="{DynamicResource SelectedNavBrush}" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" />
                <Button x:Name="ServersNav" Content="◎   Locations" Click="ServersNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" BorderThickness="0" Background="Transparent" />
                <Button x:Name="LoginNav" Content="◉   Firefox account" Click="LoginNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" BorderThickness="0" Background="Transparent" />
                <Button x:Name="AccountNav" Content="◌   Account usage" Click="AccountNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" BorderThickness="0" Background="Transparent" />
                <Rectangle Height="1" Fill="{DynamicResource BorderBrushSoft}" Margin="8,14,8,14" />
                <Button x:Name="SettingsNav" Content="⚙   Settings" Click="SettingsNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" BorderThickness="0" Background="Transparent" />
                <Button x:Name="LogsNav" Content="≡   Diagnostics" Click="LogsNav_Click" HorizontalContentAlignment="Left" Padding="14,11" Margin="0,2" BorderThickness="0" Background="Transparent" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- Large-title header with a capsule status pill. -->
            <Grid Grid.Row="0" Margin="12,0,32,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle" Text="Overview" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="14,9" VerticalAlignment="Center" Effect="{StaticResource SoftCardShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#E8A947" Margin="0,0,9,0" />
                        <TextBlock x:Name="HeaderStatus" Text="VPN engine in development" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="12,4,32,28" ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>
