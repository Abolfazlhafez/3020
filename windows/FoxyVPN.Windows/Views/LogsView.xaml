<UserControl x:Class="FoxyVPN.Windows.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Application logs" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Persistent diagnostic events. Authentication tokens and passwords are never written to the log." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,18" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding}" FontFamily="Consolas" FontSize="12" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Background="{DynamicResource CardBrush}" Padding="10" />
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Logs are stored in the current Windows user's LocalAppData folder." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Clear view" Click="ClearButton_Click" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Open log folder" Click="OpenFolderButton_Click" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export diagnostics ZIP" Click="ExportDiagnosticsButton_Click" Margin="12,0,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
