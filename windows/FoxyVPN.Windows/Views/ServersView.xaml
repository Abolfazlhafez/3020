<UserControl x:Class="FoxyVPN.Windows.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="VPN locations" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="The list is fetched from Mozilla Remote Settings; no sample or placeholder locations are bundled." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,18" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Margin="0,0,12,0" VerticalContentAlignment="Center" ToolTip="Filter by country, city, or endpoint" TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="FavoritesOnlyCheck" Grid.Column="1" Content="Favorites only" VerticalAlignment="Center" Margin="0,0,14,0" Checked="FavoritesOnlyCheck_Changed" Unchecked="FavoritesOnlyCheck_Changed" />
            <Button Grid.Column="2" Content="Refresh list" Click="RefreshButton_Click" Margin="0" />
        </Grid>
        <DataGrid x:Name="ServerGrid" Grid.Row="2" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="ServerGrid_MouseDoubleClick" SelectionChanged="ServerGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Country" Binding="{Binding CountryName}" Width="1.1*" />
                <DataGridTextColumn Header="City" Binding="{Binding CityName}" Width="1.1*" />
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="1.4*" />
                <DataGridTextColumn Header="Code" Binding="{Binding CountryCode}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready to load locations." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Use selected location" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Click="UseSelectedButton_Click" />
            <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Content="☆ Add favorite" Margin="8,0,0,0" Click="FavoriteButton_Click" />
            <Button x:Name="ProbeButton" DockPanel.Dock="Right" Content="Test TCP" Margin="8,0,0,0" Click="ProbeButton_Click" />
        </DockPanel>
    </Grid>
</UserControl>
