<UserControl x:Class="FoxyVPN.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="850" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Desktop equivalents of the settings in the Android app. Some network options remain in development; the account, tunnel and route behavior must be validated on real Windows before production use." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,22" TextWrapping="Wrap" />
            <Border Style="{StaticResource HoverCardStyle}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Appearance" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="ThemeCombo" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
                    <CheckBox x:Name="LowResourceModeCheck" Content="Low-resource mode (recommended: less CPU and background animation)" Margin="0,0,0,8" />
                    <CheckBox x:Name="ReduceMotionCheck" Content="Reduce motion (disable ambient loops and page slides)" Margin="0,0,0,10" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start FoxyVPN automatically when I sign in to Windows" Margin="0,9,0,0" />
                    <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized on Windows sign-in" Margin="22,3,0,0" />
                    <CheckBox x:Name="AutoRefreshServersCheck" Content="Refresh the live server catalog automatically" Margin="0,9,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="22,3,0,8">
                        <TextBlock Text="Refresh interval" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox x:Name="RefreshIntervalCombo" Width="100" Margin="10,0,0,0"><ComboBoxItem Content="5 minutes"/><ComboBoxItem Content="15 minutes"/><ComboBoxItem Content="30 minutes"/></ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ConnectOnLaunchCheck" Content="Connect automatically after FoxyVPN starts (requires a saved session and server)" />
                    <CheckBox x:Name="ConfirmDisconnectCheck" Content="Confirm before disconnecting" />
                    <CheckBox x:Name="ExitCheckCheck" Content="Verify external IP after a future connection" />
                    <CheckBox x:Name="ProxyOnlyModeCheck" Content="Proxy-only mode (local SOCKS5 via HTTP/2; no system-wide routing)" />
                    <TextBlock Text="Per-application split tunneling is not available. Windows Firewall program rules alone do not route an application through Wintun, so FoxyVPN does not expose a misleading per-app split-tunnel toggle." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,7,0,0" MaxWidth="680" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource HoverCardStyle}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Local SOCKS and DNS" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="SOCKS bind address" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="SocksBindCombo" Width="280" HorizontalAlignment="Left"><ComboBoxItem Content="127.0.0.1 — This PC only"/></ComboBox>
                    <TextBlock Text="Local SOCKS port" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="SocksPortText" Width="140" HorizontalAlignment="Left" />
                    <TextBlock Text="Proxy-only affects only applications you explicitly configure to use this SOCKS5 endpoint. UDP and Windows system-wide TUN routing are not included in this build." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,7,0,0" MaxWidth="520"/>
                    <CheckBox x:Name="CustomDnsEnabledCheck" Content="Use a custom DNS server" />
                    <TextBlock Text="DNS provider" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="DohCombo" Width="280" HorizontalAlignment="Left"><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Cloudflare"/><ComboBoxItem Content="Google"/><ComboBoxItem Content="Quad9"/><ComboBoxItem Content="Off"/></ComboBox>
                    <TextBlock Text="Custom DNS IP address" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="CustomDnsText" Width="280" HorizontalAlignment="Left" />
                    <TextBlock Text="Custom Fastly edge host or IP (optional)" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="CustomEdgeText" Width="360" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource HoverCardStyle}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Upstream proxy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="UpstreamEnabledCheck" Content="Chain connections through an upstream proxy" />
                    <TextBlock Text="Proxy type" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox x:Name="UpstreamTypeCombo" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="SOCKS5"/><ComboBoxItem Content="HTTP"/></ComboBox>
                    <TextBlock Text="Host" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="UpstreamHostText" Width="360" HorizontalAlignment="Left" />
                    <TextBlock Text="Port" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="UpstreamPortText" Width="140" HorizontalAlignment="Left" />
                    <TextBlock Text="Username (optional)" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="UpstreamUsernameText" Width="360" HorizontalAlignment="Left" />
                    <TextBlock Text="Password (encrypted with Windows DPAPI)" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <PasswordBox x:Name="UpstreamPasswordInput" Width="360" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,18">
                <TextBlock x:Name="StatusText" Text="Settings are stored locally." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Button DockPanel.Dock="Right" Content="Save settings" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="12,0,0,0" Click="SaveButton_Click" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
