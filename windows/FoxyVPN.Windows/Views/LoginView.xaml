<UserControl x:Class="FoxyVPN.Windows.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="520" HorizontalAlignment="Left">
            <TextBlock Text="Firefox account" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Authenticate with Firefox Accounts to access the Guardian VPN entitlement." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,24" TextWrapping="Wrap" />
            <Border Style="{StaticResource HoverCardStyle}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="26">
                <StackPanel>
                    <StackPanel x:Name="CredentialsPanel">
                        <TextBlock Text="Email address" FontWeight="SemiBold" />
                        <TextBox x:Name="EmailBox" AutomationProperties.Name="Firefox account email" />
                        <TextBlock Text="Password" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Firefox account password" />
                        <Button x:Name="SignInButton" Content="Sign in" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,12,0,0" Click="SignInButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed">
                        <TextBlock Text="Check your email" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Enter the verification code sent by Firefox Accounts to finish sign-in." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
                        <TextBlock Text="Verification code" FontWeight="SemiBold" />
                        <TextBox x:Name="CodeBox" MaxLength="12" />
                        <Button x:Name="VerifyButton" Content="Verify and continue" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,12,0,0" Click="VerifyButton_Click" />
                        <Button Content="Back to sign in" HorizontalAlignment="Left" Click="BackButton_Click" />
                    </StackPanel>
                    <Border Background="#F5F7FB" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                        <TextBlock x:Name="StatusText" Text="Your password is used only for the Firefox Accounts authentication request and is not stored by this app." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Text="Security note: session tokens and saved settings are protected with Windows DPAPI for the current Windows user." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
