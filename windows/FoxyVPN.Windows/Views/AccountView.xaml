<UserControl x:Class="FoxyVPN.Windows.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Account and usage" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Live entitlement information from Firefox VPN Guardian." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,22" />
            <Border Style="{StaticResource HoverCardStyle}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="24">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Firefox VPN entitlement" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="12,0,0,0" Click="RefreshButton_Click" />
                    </DockPanel>
                    <TextBlock x:Name="StatusText" Text="Sign in to retrieve your current account status." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,20" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Entitlement" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="EntitlementText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Remaining allowance" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="RemainingText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="UsageBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,18,0,0" />
                    <TextBlock x:Name="UsageText" Text="Usage percentage is not available." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="The allowance and entitlement are fetched live. If the account API is unreachable or blocked by an anti-bot challenge, the page reports that error instead of displaying sample values." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
